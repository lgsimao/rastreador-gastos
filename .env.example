# Copie este arquivo para .env e preencha os valores
# NÃO suba o arquivo .env para o GitHub!

# Cole aqui a URL do PostgreSQL do Railway (ex: postgresql://user:pass@host:5432/dbname)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Chave secreta para JWT — coloque qualquer texto longo e aleatório
JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria

# Porta local (Railway define automaticamente)
PORT=3001
